# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Database Configuration
# For local development, use: postgresql://user:password@localhost:5432/phantom_bot
# For cloud services (Supabase, Neon, Railway), use the connection string they provide
DATABASE_URL=postgresql://user:password@localhost:5432/phantom_bot

# Environment
NODE_ENV=development
