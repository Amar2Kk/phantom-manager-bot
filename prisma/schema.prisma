// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Guild (Discord Server) settings
model Guild {
  id                      String   @id // Discord Guild ID
  name                    String
  leaderboardChannelId    String?  // Channel for live credits leaderboard
  leaderboardMessageId    String?  // Message ID of the leaderboard
  logChannelId            String?  // Channel for bot action logs
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("guilds")
}

// Shop Orders
model Order {
  id              String      @id @default(cuid())
  orderId         String // Custom order ID from user
  guildId         String
  game            String // Game name
  price           Float // Order price
  assignedUserId  String // User assigned to complete the order
  createdBy       String // Discord user ID who created the order
  status          OrderStatus @default(PENDING)
  paymentReceived Boolean     @default(false) // Whether payment has been received
  completedAt     DateTime?
  canceledAt      DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([orderId, guildId])
  @@index([guildId])
  @@index([assignedUserId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING // Order pending
  DONE // Order completed
  CANCELED // Order canceled
}

// User Credits (earnings from completed orders)
model UserCredit {
  id        String   @id @default(cuid())
  userId    String // Discord user ID
  guildId   String
  credits   Float    @default(0) // Total credits earned
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([guildId])
  @@index([userId])
  @@map("user_credits")
}
